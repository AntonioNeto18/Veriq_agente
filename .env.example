# Credenciais do provedor de IA (nunca versione o arquivo .env real)
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Modelo usado pelo agente (vazio = padrão do ADK instalado, gemini-3.5-flash no google-adk 2.13.0)
VERIQ_MODEL=

# Diretório de onde especificações podem ser lidas (vazio = diretório atual)
VERIQ_SPEC_DIR=

# Diretório onde collections geradas são gravadas (vazio = ./output)
VERIQ_OUTPUT_DIR=

# Tamanho máximo aceito para arquivos OpenAPI (MB)
VERIQ_MAX_SPEC_MB=10
