{
  "openapi": "3.1.0",
  "info": {"title": "Users API 3.1", "version": "2.0.0"},
  "servers": [{"url": "https://api.example.com/{env}", "variables": {"env": {"default": "v2"}}}],
  "paths": {
    "/users/{id}": {
      "get": {
        "operationId": "getUser",
        "tags": ["users"],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "session", "in": "cookie", "schema": {"type": "string"}}
        ],
        "security": [{"apiKey": []}, {"oauth": ["users:read"]}],
        "responses": {
          "200": {
            "description": "Usuário",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/User"}}}
          }
        }
      }
    }
  },
  "webhooks": {
    "userCreated": {"post": {"responses": {"200": {"description": "ok"}}}}
  },
  "components": {
    "securitySchemes": {
      "apiKey": {"type": "apiKey", "in": "header", "name": "X-API-Key"},
      "oauth": {
        "type": "oauth2",
        "flows": {"clientCredentials": {"tokenUrl": "https://auth.example.com/token", "scopes": {"users:read": "ler"}}}
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "nickname": {"type": ["string", "null"]}
        }
      }
    }
  }
}
